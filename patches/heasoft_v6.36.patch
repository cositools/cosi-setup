+	 */
+	char nameBuf[256];
+	char *dash;
+	strncpy(nameBuf, strchr(nameList[i] + 1, '-') + 1, sizeof(nameBuf) - 1);
+	nameBuf[sizeof(nameBuf) - 1] = '\0';
